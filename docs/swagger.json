{
    "swagger": "2.0",
    "info": {
        "title": "Social App API",
        "contact": {}
    },
    "basePath": "/v1",
    "paths": {
        "/users/{id}": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
